{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/volunteer",
      "destination": "/volunteer.html"
    }
  ],
  "functions": {
    "api/tiles.js": {
      "maxDuration": 30
    },
    "api/live.js": {
      "maxDuration": 30
    },
    "api/ingest.js": {
      "maxDuration": 30
    }
  }
}
